generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(uuid())
  discordId   String  @unique @map("discord_id")
  displayName String  @map("display_name")
  avatarUrl   String? @map("avatar_url")

  isAdmin     Boolean @default(false) @map("is_admin")
  isModerator Boolean @default(false) @map("is_moderator")
  isSuspended Boolean @default(false) @map("is_suspended")

  kickUsername String?  @unique @map("kick_username")
  kickVerified Boolean  @default(false) @map("kick_verified")

  twitchUsername String?  @unique @map("twitch_username")
  twitchVerified Boolean  @default(false) @map("twitch_verified")

  catCoinBalance Int @default(0) @map("cat_coin_balance")
  totalEarned    Int @default(0) @map("total_earned")
  totalSpent     Int @default(0) @map("total_spent")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  sessions  UserSession[]
  auditLogsAsAdmin  AuditLog[] @relation("AdminAuditLogs")
  auditLogsAsTarget AuditLog[] @relation("TargetAuditLogs")
  hunts     Hunt[]

  createdTournaments     Tournament[]             @relation("TournamentCreator")
  tournamentEntries      TournamentEntry[]        @relation("TournamentEntries")
  tournamentParticipations TournamentParticipant[] @relation("TournamentParticipants")
  siteContentEdits       SiteContent[]

  createdStreamGames       StreamGame[]       @relation("StreamGameCreator")
  createdPredictionMatches PredictionMatch[]  @relation("PredictionMatchCreator")
  predictionVotes          PredictionVote[]
  createdLadderRuns        LadderRun[]        @relation("LadderRunCreator")

  huntGuesses    HuntGuess[] @relation("HuntGuesses")
  wonHuntGuesses Hunt[]      @relation("HuntGuessWinner")

  createdGiveaways Giveaway[]      @relation("GiveawayCreator")
  wonGiveaways     Giveaway[]      @relation("GiveawayWinner")
  giveawayEntries  GiveawayEntry[] @relation("GiveawayEntries")

  createdWagerLeaderboards WagerLeaderboard[]

  @@index([kickUsername], map: "idx_users_kick_username")
  @@index([twitchUsername], map: "idx_users_twitch_username")
  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  tokenHash        String   @map("token_hash")
  refreshTokenHash String?  @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  targetId   String?  @map("target_id")
  action     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  admin  User  @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  target User? @relation("TargetAuditLogs", fields: [targetId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

enum HuntStatus {
  COLLECTING
  OPENING
  COMPLETED
}

model Hunt {
  id            String     @id @default(uuid())
  slug          String     @unique
  name          String
  currency      String     @default("USD")
  startBalance  Decimal    @map("start_balance") @db.Decimal(12, 2)
  /// Array of HuntBonus: { id, slotName, provider, image, bet, payout, note, addedAt }
  bonuses       Json       @default("[]")
  status        HuntStatus @default(COLLECTING)
  isLive        Boolean    @default(false) @map("is_live")

  /// "Guess the Balance" — the admin explicitly opens guessing (typically
  /// once bonus collection is done), viewers guess where the hunt will end
  /// up, and closest guess wins guessPrizeCoins once the admin enters the
  /// real final balance.
  guessesOpen    Boolean  @default(false) @map("guesses_open")
  guessPrizeCoins Int     @default(0) @map("guess_prize_coins")
  finalBalance   Decimal? @map("final_balance") @db.Decimal(12, 2)
  guessWinnerId  String?  @map("guess_winner_id")
  guessWinner    User?    @relation("HuntGuessWinner", fields: [guessWinnerId], references: [id], onDelete: SetNull)
  guesses        HuntGuess[]

  /// !sr <slot name> in Twitch/Kick chat while the hunt is live — a raw
  /// suggestion queue for the admin to review, not auto-added (no bet
  /// amount comes with a chat suggestion).
  slotSuggestions HuntSlotSuggestion[]

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([isLive], map: "idx_hunts_is_live")
  @@map("hunts")
}

model HuntGuess {
  id        String   @id @default(uuid())
  huntId    String   @map("hunt_id")
  userId    String   @map("user_id")
  guess     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hunt Hunt @relation(fields: [huntId], references: [id], onDelete: Cascade)
  user User @relation("HuntGuesses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([huntId, userId])
  @@map("hunt_guesses")
}

model HuntSlotSuggestion {
  id           String               @id @default(uuid())
  huntId       String               @map("hunt_id")
  slotName     String               @map("slot_name")
  /// Parsed from a recognized provider prefix in the !sr command (e.g.
  /// "pragmatic <name>"), or "Other" if none matched — admin can retag.
  provider     String               @default("Other")
  chatUsername String               @map("chat_username")
  source       PredictionVoteSource
  createdAt    DateTime             @default(now()) @map("created_at")

  hunt Hunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId], map: "idx_hunt_slot_suggestions_hunt")
  @@map("hunt_slot_suggestions")
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  SLOT_SELECTION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model Tournament {
  id               String           @id @default(uuid())
  title            String
  status           TournamentStatus @default(DRAFT)
  maxPlayers       Int              @default(8) @map("max_players")
  slotTimerSeconds Int              @default(180) @map("slot_timer_seconds")
  prizeCoins       Int              @default(0) @map("prize_coins")
  currentRound     Int              @default(0) @map("current_round")

  createdById String @map("created_by_id")
  createdBy   User   @relation("TournamentCreator", fields: [createdById], references: [id])

  entries      TournamentEntry[]
  participants TournamentParticipant[]
  matches      TournamentMatch[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@map("tournaments")
}

model TournamentEntry {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  enteredAt    DateTime @default(now()) @map("entered_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("TournamentEntries", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_entries")
}

model TournamentParticipant {
  id            String    @id @default(uuid())
  tournamentId  String    @map("tournament_id")
  userId        String    @map("user_id")
  seed          Int?
  slotCall      String?   @map("slot_call")
  slotConfirmed Boolean   @default(false) @map("slot_confirmed")
  slotDeadline  DateTime? @map("slot_deadline")
  eliminated    Boolean   @default(false)
  finalPosition Int?      @map("final_position")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("TournamentParticipants", fields: [userId], references: [id], onDelete: Cascade)

  matchesAsA TournamentMatch[] @relation("MatchParticipantA")
  matchesAsB TournamentMatch[] @relation("MatchParticipantB")
  matchesWon TournamentMatch[] @relation("MatchWinner")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

model TournamentMatch {
  id             String      @id @default(uuid())
  tournamentId   String      @map("tournament_id")
  round          Int
  matchNumber    Int         @map("match_number")
  status         MatchStatus @default(PENDING)
  participantAId String?     @map("participant_a_id")
  participantBId String?     @map("participant_b_id")
  winnerId       String?     @map("winner_id")
  nextMatchId    String?     @map("next_match_id")

  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantA TournamentParticipant? @relation("MatchParticipantA", fields: [participantAId], references: [id])
  participantB TournamentParticipant? @relation("MatchParticipantB", fields: [participantBId], references: [id])
  winner       TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tournamentId, round, matchNumber])
  @@map("tournament_matches")
}

/// Admin-editable homepage/site content, keyed by section. Shape of `data`
/// depends on `key` — validated server-side in SiteContentService, not by
/// the database. Lets the admin dashboard manage copy that used to be
/// hardcoded (schedule, announcements, store, giveaway, etc.) without a
/// schema change per section.
model SiteContent {
  key         String   @id
  data        Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_content")
}

/// Catalog of viewer-facing stream games (e.g. Chat vs Streamer). Admin-managed
/// list; the actual gameplay for each game lives in its own dedicated tables
/// (see PredictionMatch below for Chat vs Streamer).
model StreamGame {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(true) @map("is_active")
  isVisible   Boolean @default(true) @map("is_visible")
  sortOrder   Int     @default(0) @map("sort_order")

  /// Off by default — points are cosmetic/in-platform only. When enabled,
  /// prizeRulesText should hold the streamer's own eligibility/compliance
  /// disclosure before any run is treated as awarding a real-world prize.
  prizeModeEnabled Boolean @default(false) @map("prize_mode_enabled")
  prizeRulesText   String? @map("prize_rules_text")

  createdById String @map("created_by_id")
  createdBy   User   @relation("StreamGameCreator", fields: [createdById], references: [id])

  predictionMatches PredictionMatch[]
  ladderRuns        LadderRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stream_games")
}

enum PredictionChoice {
  CHAT
  STREAMER
}

enum PredictionMatchFormat {
  SHORT
  NORMAL
  EVENT
}

enum PredictionMatchStatus {
  ACTIVE
  COMPLETED
}

enum PredictionRoundStatus {
  OPEN
  LOCKED
  RESOLVED
  VOID
}

enum PredictionVoteSource {
  TWITCH
  KICK
}

/// A single Chat vs Streamer match. Each round, chat votes "!win chat" or
/// "!win streamer" on whether the streamer's stated call will be correct;
/// see PredictionService for the full scoring/streak logic.
model PredictionMatch {
  id           String                @id @default(uuid())
  streamGameId String                @map("stream_game_id")
  format       PredictionMatchFormat @default(NORMAL)
  targetScore  Int                   @default(15) @map("target_score")
  status       PredictionMatchStatus @default(ACTIVE)

  chatScore        Int     @default(0) @map("chat_score")
  streamerScore    Int     @default(0) @map("streamer_score")
  chatStreak       Int     @default(0) @map("chat_streak")
  streamerStreak   Int     @default(0) @map("streamer_streak")
  chatUnderdog     Boolean @default(false) @map("chat_underdog")
  streamerUnderdog Boolean @default(false) @map("streamer_underdog")

  winner        PredictionChoice?
  challengeText String?           @map("challenge_text")

  createdById String @map("created_by_id")
  createdBy   User   @relation("PredictionMatchCreator", fields: [createdById], references: [id])
  streamGame  StreamGame @relation(fields: [streamGameId], references: [id])

  rounds PredictionRound[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([streamGameId, status], map: "idx_prediction_matches_game_status")
  @@map("prediction_matches")
}

model PredictionRound {
  id           String                @id @default(uuid())
  matchId      String                @map("match_id")
  roundNumber  Int                   @map("round_number")
  question     String
  streamerCall String                @map("streamer_call")
  status       PredictionRoundStatus @default(OPEN)

  votesChat       Int               @default(0) @map("votes_chat")
  votesStreamer   Int               @default(0) @map("votes_streamer")
  chatPick        PredictionChoice? @map("chat_pick")
  streamerCorrect Boolean?          @map("streamer_correct")

  match PredictionMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  votes PredictionVote[]

  openedAt   DateTime? @map("opened_at")
  lockedAt   DateTime? @map("locked_at")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([matchId, roundNumber])
  @@map("prediction_rounds")
}

/// One viewer's vote for a round, sourced from a live Twitch or Kick chat
/// command. userId is only set when chatUsername matches a verified,
/// linked site account — unlinked chatters still count toward the round
/// but don't appear on the personal leaderboard.
model PredictionVote {
  id           String               @id @default(uuid())
  roundId      String               @map("round_id")
  choice       PredictionChoice
  source       PredictionVoteSource
  chatUsername String               @map("chat_username")
  userId       String?              @map("user_id")

  round PredictionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roundId, chatUsername])
  @@index([userId], map: "idx_prediction_votes_user")
  @@map("prediction_votes")
}

enum LadderRunStatus {
  ACTIVE
  CASHED_OUT
  FAILED
  COMPLETED
}

/// Which sub-state an ACTIVE run is in: ATTEMPTING a challenge at
/// currentLevel + 1, or in the DECISION window after clearing currentLevel
/// (cash out vs climb higher).
enum LadderRunPhase {
  ATTEMPTING
  DECISION
}

/// One climber's run up the six-rung ladder. Level definitions (points,
/// label, safety net) are fixed and live in LadderService, not the DB —
/// there's only ever one ladder shape.
model LadderRun {
  id              String          @id @default(uuid())
  streamGameId    String          @map("stream_game_id")
  participantName String          @map("participant_name")
  status          LadderRunStatus @default(ACTIVE)
  phase           LadderRunPhase  @default(ATTEMPTING)
  currentLevel    Int             @default(0) @map("current_level")
  securedFloor    Int             @default(0) @map("secured_floor")
  finalPoints     Int?            @map("final_points")

  chatPassVotes    Int @default(0) @map("chat_pass_votes")
  chatFailVotes    Int @default(0) @map("chat_fail_votes")
  chatCashoutVotes Int @default(0) @map("chat_cashout_votes")
  chatClimbVotes   Int @default(0) @map("chat_climb_votes")

  createdById String @map("created_by_id")
  createdBy   User   @relation("LadderRunCreator", fields: [createdById], references: [id])
  streamGame  StreamGame @relation(fields: [streamGameId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  endedAt   DateTime? @map("ended_at")

  @@index([streamGameId, status], map: "idx_ladder_runs_game_status")
  @@map("ladder_runs")
}

enum GiveawayStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

/// A real raffle: viewers enter (optionally spending coins), the admin
/// closes entries and draws a winner from whoever actually entered.
model Giveaway {
  id          String         @id @default(uuid())
  title       String
  description String?
  entryCost   Int            @default(0) @map("entry_cost")
  /// Free-text eligibility rule shown to viewers, e.g. "Must have wagered
  /// $100+ in the last 7 days to qualify." Not automatically enforced —
  /// there's no per-user, time-windowed wager history to check against, so
  /// this is informational; the admin curates who actually qualifies via
  /// adminAddEntry/adminRemoveEntry.
  requirementText String?      @map("requirement_text")
  status          GiveawayStatus @default(DRAFT)
  endsAt          DateTime?      @map("ends_at")

  winnerId String? @map("winner_id")
  winner   User?   @relation("GiveawayWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  createdById String @map("created_by_id")
  createdBy   User   @relation("GiveawayCreator", fields: [createdById], references: [id])

  entries GiveawayEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  drawnAt   DateTime? @map("drawn_at")

  @@map("giveaways")
}

model GiveawayEntry {
  id            String   @id @default(uuid())
  giveawayId    String   @map("giveaway_id")
  userId        String   @map("user_id")
  /// True when an admin added this entry directly (e.g. after manually
  /// confirming they meet a wager requirement) rather than the viewer
  /// self-entering — admin-added entries are never charged entryCost.
  addedByAdmin  Boolean  @default(false) @map("added_by_admin")
  enteredAt     DateTime @default(now()) @map("entered_at")

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation("GiveawayEntries", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@map("giveaway_entries")
}

/// A manually-tracked wager race — admin types in each player's wagered
/// total (from the casino's own back-office, there's no live wager API
/// integration) and the site ranks them. Displayed publicly as
/// "<prizeAmount> Leaderboard" (e.g. "$250 Leaderboard").
model WagerLeaderboard {
  id          String  @id @default(uuid())
  title       String? // optional override; auto-generated from prizeAmount/currency if unset
  prizeAmount Decimal @map("prize_amount") @db.Decimal(12, 2)
  currency    String  @default("USD")
  /// Array of WagerEntry: { id, name, wagered, avatarUrl }
  entries     Json    @default("[]")
  isLive      Boolean @default(false) @map("is_live")

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isLive], map: "idx_wager_leaderboards_is_live")
  @@map("wager_leaderboards")
}
